{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=ecommerce_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Ecommerce.Api",
    "Audience": "Ecommerce.Frontend",
    "Key": "CHANGE_ME_SUPER_SECRET_KEY_1234567890",
    "ExpirationMinutes": 120
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:29092",
    "ClientId": "ecommerce-api",
    "OrderCreatedTopic": "ecommerce.orders.created.v1",
    "OutboxBatchSize": 50,
    "OutboxPollingIntervalSeconds": 5,
    "OutboxMaxRetryDelaySeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
