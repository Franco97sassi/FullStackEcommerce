# PostgreSQL
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
# Backend
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080
JWT_KEY=supersecretkey_dev_only_change_me
JWT_ISSUER=Ecommerce.API
JWT_AUDIENCE=Ecommerce.Web

# Kafka (enabled automatically by Docker Compose)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ORDER_CREATED_TOPIC=ecommerce.orders.created.v1

# gRPC interno (use un secreto fuerte fuera de Development)
GRPC__AUTHENTICATION__APIKEY=change-me-service-secret
GRPC__SERVICES__ADDRESS=https://backend:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Frontend
BACKEND_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
